{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "ARGUS_RELEASE_ED25519_KEY",
    "ARGUS_SKILL_SMOKE_TEST_CREDENTIALS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
