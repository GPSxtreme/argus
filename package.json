{
  "name": "argus",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "argus": "tsx apps/cli/src/main.ts",
    "build": "turbo build",
    "dev": "tsx apps/argus/src/main.ts",
    "lint": "biome lint --error-on-warnings .",
    "lint:check": "biome lint --error-on-warnings .",
    "start": "tsx apps/argus/src/main.ts",
    "test": "vitest run",
    "typecheck": "turbo typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "tsx": "^4.20.0",
    "turbo": "^2.5.0",
    "typescript": "^6.0.0",
    "vitest": "^3.2.0"
  }
}
